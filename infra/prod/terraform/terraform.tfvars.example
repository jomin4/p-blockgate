# 복사해서 terraform.tfvars 로 사용 (terraform.tfvars는 커밋 금지)
# 값은 Phase 5에서 개발자에게 받아 Claude Code가 채운다.

tenancy_ocid     = "ocid1.tenancy.oc1..xxxx"
user_ocid        = "ocid1.user.oc1..xxxx"
fingerprint      = "xx:xx:xx:..."
private_key_path = "~/.oci/oci_api_key.pem"
region           = "ap-osaka-1"

# Object Storage namespace (state 버킷용)
namespace = "xxxx"

# 시리얼 콘솔 복구용 SSH 공개키 (공개 SSH 포트는 열지 않음)
ssh_public_key = "ssh-ed25519 AAAA... you@pc"

# Tailscale 일회용·만료형 auth key (tag:server)
tailscale_auth_key = "tskey-auth-xxxx"

# 사양 (무료 한도 내 고정값)
instance_ocpus        = 2
instance_memory_gb    = 12
boot_volume_size_gb   = 50
data_volume_size_gb   = 100
