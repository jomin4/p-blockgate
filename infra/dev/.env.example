# 로컬 개발 서버 환경변수 — 복사해서 .env 로 사용 (.env는 커밋 금지)
COMPOSE_PROJECT_NAME=blockgate-dev

# Minecraft (버전·빌드는 compose.yaml에 고정 — docs/01-tech-stack.md)
MC_MEMORY=4G
# EULA는 개발자 동의 후 TRUE
MC_EULA=FALSE
MC_RCON_PASSWORD=change-me-local

# PostgreSQL
DB_NAME=blockgate
DB_USER=blockgate
DB_PASSWORD=change-me-local
